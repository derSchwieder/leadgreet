# PostgreSQL connection string (Neon-compatible, local Postgres-compatible)
# Local Docker: postgresql://leadgreet:leadgreet@localhost:5432/leadgreet?schema=public
# Neon:        postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL="postgresql://leadgreet:leadgreet@localhost:5432/leadgreet?schema=public"

# Tavily Search API — active provider for screening web research. Never commit a real key.
# Put the real value in .env.local (gitignored).
TAVILY_API_KEY=""

# Optional leftover provider. Not used by the screening flow.
BRAVE_SEARCH_API_KEY=""

# OpenAI Chat Completions — screening LLM analysis after Tavily research. Never commit a real key.
# Put the real value in .env.local (gitignored).
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
